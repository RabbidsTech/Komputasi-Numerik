        "# ======================================================================\n",
        "# CELL 1: FUNGSI BANTU UNTUK MENCETAK MATRIKS AUGMENTED\n",
        "# ======================================================================\n",
        "# Identitas: Kresna Tri Samudra (NIM: 202511420050)\n",
        "\n",
        "def cetak_matriks(M, judul=\"\"):\n",
        "    \"\"\"Fungsi untuk menampilkan matriks augmented [A | b] ke layar secara terformat.\"\"\"\n",
        "    # Mengecek apakah parameter 'judul' diisi; jika ada, cetak sebagai keterangan langkah\n",
        "    if judul:\n",
        "        print(judul)\n",
        "    \n",
        "    # Melakukan iterasi untuk setiap baris di dalam matriks M\n",
        "    for baris in M:\n",
        "        # baris[:-1] mengambil seluruh elemen koefisien matriks A (kolom 0 sampai n-1)\n",
        "        # f\"{v:9.4f}\" memformat setiap angka menjadi lebar 9 karakter dengan 4 angka di belakang koma\n",
        "        bagian_kiri = \"  \".join(f\"{v:9.4f}\" for v in baris[:-1])\n",
        "        \n",
        "        # baris[-1] mengambil elemen terakhir pada baris, yaitu vektor konstanta b\n",
        "        bagian_kanan = f\"{baris[-1]:9.4f}\"\n",
        "        \n",
        "        # Menggabungkan bagian kiri dan kanan dengan pemisah '|' agar terlihat seperti matriks augmented\n",
        "        print(\"  [\" + bagian_kiri + \"  |  \" + bagian_kanan + \" ]\")\n",
        "    \n",
        "    # Mencetak baris kosong sebagai spasi antar langkah matriks\n",
        "    print()"
