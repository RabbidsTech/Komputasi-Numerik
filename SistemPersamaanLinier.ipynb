        "# ======================================================================\n",
        "# CELL 2: FUNGSI UTAMA ALGORITMA ELIMINASI GAUSS-JORDAN\n",
        "# ======================================================================\n",
        "\n",
        "def gauss_jordan(A, b, tampilkan_langkah=True):\n",
        "    # Menghitung jumlah baris/persamaan (n) dari panjang matriks A\n",
        "    n = len(A)\n",
        "    \n",
        "    # Membentuk matriks augmented M berukuran n x (n+1) dengan menggabungkan tiap baris A dan elemen b\n",
        "    # Semua elemen dikonversi ke tipe float agar operasi pembagian menghasilkan bilangan desimal akurat\n",
        "    M = [list(map(float, A[i])) + [float(b[i])] for i in range(n)]\n",
        "\n",
        "    # Jika tampilkan_langkah bernilai True, cetak kondisi matriks augmented sebelum diproses\n",
        "    if tampilkan_langkah:\n",
        "        cetak_matriks(M, \"Matriks augmented awal:\")\n",
        "\n",
        "    # Loop utama iterasi per kolom (dari kolom 0 hingga n-1) untuk memproses setiap elemen pivot diagonal\n",
        "    for kol in range(n):\n",
        "        # 1. TAHAP PIVOTING PARSIAL:\n",
        "        # Mencari indeks baris 'r' (mulai dari baris 'kol' ke bawah) yang memiliki nilai absolut terbesar pada kolom 'kol'\n",
        "        pivot = max(range(kol, n), key=lambda r: abs(M[r][kol]))\n",
        "        \n",
        "        # Mengecek apakah nilai pivot terbesar mendekati nol (< 1e-12); jika ya, matriks bersifat singular (tidak punya solusi tunggal)\n",
        "        if abs(M[pivot][kol]) < 1e-12:\n",
        "            print(\"Matriks singular: tidak ada solusi tunggal.\")\n",
        "            return None\n",
        "\n",
        "        # Jika baris pivot yang ditemukan bukan baris diagonal saat ini, tukar posisi kedua baris tersebut\n",
        "        if pivot != kol:\n",
        "            M[kol], M[pivot] = M[pivot], M[kol]\n",
        "            if tampilkan_langkah:\n",
        "                cetak_matriks(M, f\"Tukar R{kol+1} <-> R{pivot+1}:\")\n",
        "\n",
        "        # 2. TAHAP NORMALISASI BARIS PIVOT:\n",
        "        # Menyimpan nilai elemen diagonal utama saat ini ke variabel 'p'\n",
        "        p = M[kol][kol]\n",
        "        # Membagi seluruh elemen pada baris pivot dengan 'p' sehingga elemen diagonal utama bernilai 1\n",
        "        M[kol] = [v / p for v in M[kol]]\n",
        "        if tampilkan_langkah:\n",
        "            cetak_matriks(M, f\"R{kol+1} = R{kol+1} / {p:.4f}:\")\n",
